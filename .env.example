# Primary LLM API Key (Free tier Groq: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# LangSmith Observability Tracing (https://smith.langchain.com)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=kestrel-research-assistant

# Optional: TypeSafe AI JEV API Key (For System-1 Fast Verification Benchmark)
# If omitted, system defaults 100% cleanly to standard Groq verification
TYPESAFE_API_KEY=your_typesafe_api_key_here
